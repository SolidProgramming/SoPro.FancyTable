@typeparam TItem where TItem : notnull

@if (ShouldRenderCustomTemplate)
{
    @RowTemplate!(RowContext)
}
else
{
    <tr class="@GetRowClass()" @attributes="GetRowAttributes()">
        @for (int index = 0; index < VisibleColumns.Count; index++)
        {
            FancyColumn<TItem> column = VisibleColumns[index];

            <td class="@GetCellClass(column, index == 0)">
                @if (index == 0)
                {
                    <div class="tree-node-content">
                        <span class="tree-indent" style="@($"width: {Node.Depth}rem;")" aria-hidden="true"></span>

                        @if (Node.HasChildren)
                        {
                            <button type="button"
                                    class="tree-toggle-btn"
                                    @onclick="() => RowContext.ToggleNode.InvokeAsync()"
                                    aria-label="@(RowContext.IsExpanded ? CollapseLabel : ExpandLabel)"
                                    aria-expanded="@RowContext.IsExpanded">
                                <i class="bi @(RowContext.IsExpanded ? "bi-caret-down-fill" : "bi-caret-right-fill")"></i>
                            </button>
                        }
                        else
                        {
                            <span class="tree-toggle-placeholder" aria-hidden="true"></span>
                        }

                        @if (RowLeadingContentTemplate is not null)
                        {
                            @RowLeadingContentTemplate(RowContext)
                        }

                        <span class="tree-node-value">
                            @RenderCellValue(column)
                        </span>
                    </div>
                }
                else
                {
                    @RenderCellValue(column)
                }
            </td>
        }
    </tr>
}

@code {
    [Parameter, EditorRequired]
    public required TreeNodeState<TItem> Node { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<FancyColumn<TItem>> VisibleColumns { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback<TreeNodeState<TItem>> ToggleNode { get; set; }

    [Parameter]
    public Func<TItem, string?>? RowClassSelector { get; set; }

    [Parameter]
    public Func<FancyRowContext<TItem>, IReadOnlyDictionary<string, object?>?>? RowAttributesSelector { get; set; }

    [Parameter]
    public RenderFragment<FancyRowContext<TItem>>? RowLeadingContentTemplate { get; set; }

    [Parameter]
    public RenderFragment<FancyRowContext<TItem>>? RowTemplate { get; set; }

    [Parameter]
    public Func<FancyRowContext<TItem>, bool>? RowTemplateSelector { get; set; }

    [Parameter]
    public string ExpandLabel { get; set; } = "Expand";

    [Parameter]
    public string CollapseLabel { get; set; } = "Collapse";

    private FancyRowContext<TItem> RowContext => new()
    {
        Item = Node.Item,
        Columns = VisibleColumns,
        ToggleNode = EventCallback.Factory.Create(this, () => ToggleNode.InvokeAsync(Node)),
        ExpandLabel = ExpandLabel,
        CollapseLabel = CollapseLabel,
        IsTreeNode = true,
        Depth = Node.Depth,
        HasChildren = Node.HasChildren,
        IsExpanded = Node.IsExpanded
    };

    private bool ShouldRenderCustomTemplate =>
        RowTemplate is not null && (RowTemplateSelector?.Invoke(RowContext) ?? true);

    private string? GetRowClass() => RowClassSelector?.Invoke(Node.Item);

    private IReadOnlyDictionary<string, object?>? GetRowAttributes() => RowAttributesSelector?.Invoke(RowContext);

    private static string? GetCellClass(FancyColumn<TItem> column, bool isTreeColumn)
    {
        if (!isTreeColumn)
            return column.CellClass;

        return string.IsNullOrWhiteSpace(column.CellClass)
            ? "tree-node-cell"
            : $"{column.CellClass} tree-node-cell";
    }

    private RenderFragment RenderCellValue(FancyColumn<TItem> column) => builder =>
    {
        if (column.CellTemplate is not null)
        {
            builder.AddContent(0, column.CellTemplate(Node.Item));
            return;
        }

        builder.AddContent(1, column.ValueSelector?.Invoke(Node.Item));
    };
}


