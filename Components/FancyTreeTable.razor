@typeparam TItem where TItem : notnull
@implements IDisposable

<div class="d-flex mb-2">
    @if (ToolbarTemplate is not null)
    {
        @ToolbarTemplate
    }
    else
    {
        <div class="d-flex ms-auto">
            <input class="form-control form-control-md" placeholder="@SearchPlaceholder" value="@SearchText" @oninput="OnSearchInput" @onkeyup="HandleSearchKeyPress" />

            @if (string.IsNullOrWhiteSpace(SearchText))
            {
                <button class="btn btn-sm btn-outline-secondary mx-1" @onclick="ApplySearch">
                    <i class="bi bi-search"></i>
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary mx-1" @onclick="ClearSearch">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>
    }
</div>

<div class="tree-table-container">
    <table class="tree-table">
        <thead>
            <tr>
                @foreach (FancyColumn<TItem> column in VisibleColumns)
                {
                    <th class="@column.HeaderClass">
                        <div class="d-inline-flex align-items-center gap-1">
                            <span class="col-title">@column.Title</span>

                            @if (column.Sortable)
                            {
                                <button class="btn btn-link p-0 border-0" @onclick="() => SortBy(column.Key)">
                                    <i class="bi @(GetSortIcon(column.Key))"></i>
                                </button>
                            }

                            @if (column.Hideable)
                            {
                                <button class="btn btn-link p-0 border-0" @onclick="() => HideColumn(column.Key)">
                                    <i class="bi bi-eye-slash"></i>
                                </button>
                            }
                        </div>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (TreeNodeState<TItem> node in VisibleNodes)
            {
                <FancyTreeRow TItem="TItem"
                              Node="node"
                              VisibleColumns="VisibleColumnsList"
                              ToggleNode="ToggleNodeAsync"
                              RowClassSelector="RowClassSelector"
                              RowAttributesSelector="RowAttributesSelector"
                              RowLeadingContentTemplate="RowLeadingContentTemplate"
                              RowTemplate="RowTemplate"
                              RowTemplateSelector="RowTemplateSelector"
                              ExpandLabel="ExpandLabel"
                              CollapseLabel="CollapseLabel" />
            }
        </tbody>
    </table>

    @if (HiddenColumns.Count > 0)
    {
        <div class="mt-2 ps-2 py-1">
            <small class="text-muted me-2">Hidden columns:</small>
            @foreach (string key in HiddenColumns)
            {
                FancyColumn<TItem>? column = Columns.FirstOrDefault(c => c.Key == key);
                if (column is not null)
                {
                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ShowColumn(key)">
                        <i class="bi bi-eye me-1"></i>@column.Title
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<TItem> Items { get; set; } = Array.Empty<TItem>();

    [Parameter, EditorRequired]
    public required IReadOnlyList<FancyColumn<TItem>> Columns { get; set; } = Array.Empty<FancyColumn<TItem>>();

    [Parameter, EditorRequired]
    public required Func<TItem, IEnumerable<TItem>?> ChildItemsSelector { get; set; }

    [Parameter]
    public Func<TItem, bool>? HasChildrenSelector { get; set; }

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search";

    [Parameter]
    public string ExpandLabel { get; set; } = "Expand";

    [Parameter]
    public string CollapseLabel { get; set; } = "Collapse";

    [Parameter]
    public RenderFragment? ToolbarTemplate { get; set; }

    [Parameter]
    public Func<TItem, string, bool>? SearchPredicate { get; set; }

    [Parameter]
    public Func<TItem, string?>? RowClassSelector { get; set; }

    [Parameter]
    public Func<FancyRowContext<TItem>, IReadOnlyDictionary<string, object?>?>? RowAttributesSelector { get; set; }

    [Parameter]
    public RenderFragment<FancyRowContext<TItem>>? RowLeadingContentTemplate { get; set; }

    [Parameter]
    public RenderFragment<FancyRowContext<TItem>>? RowTemplate { get; set; }

    [Parameter]
    public Func<FancyRowContext<TItem>, bool>? RowTemplateSelector { get; set; }

    private readonly HashSet<string> HiddenColumns = new(StringComparer.Ordinal);
    private readonly Dictionary<TItem, bool> ExpandedStates = new();
    private readonly List<TreeNodeState<TItem>> RootNodes = [];
    private string? SortColumnKey;
    private bool SortAscending = true;
    private string SearchText = string.Empty;
    private string AppliedSearchText = string.Empty;
    private Timer? debounceTimer;

    private IEnumerable<FancyColumn<TItem>> VisibleColumns =>
        Columns.Where(c => !HiddenColumns.Contains(c.Key));

    private IReadOnlyList<FancyColumn<TItem>> VisibleColumnsList => VisibleColumns.ToList();

    private IEnumerable<TreeNodeState<TItem>> VisibleNodes
    {
        get
        {
            string filter = CurrentFilter;
            List<TreeNodeState<TItem>> visibleNodes = [];

            if (string.IsNullOrWhiteSpace(filter))
            {
                foreach (TreeNodeState<TItem> root in RootNodes)
                    CollectExpandedNodes(root, visibleNodes);
            }
            else
            {
                foreach (TreeNodeState<TItem> root in RootNodes)
                    CollectSearchNodes(root, filter, visibleNodes, out _);
            }

            return visibleNodes;
        }
    }

    private string CurrentFilter =>
        string.IsNullOrWhiteSpace(AppliedSearchText) ? SearchText : AppliedSearchText;

    protected override void OnParametersSet()
    {
        RebuildTree();
    }

    private void RebuildTree()
    {
        RootNodes.Clear();

        IEnumerable<TItem> sortedRootItems = ApplySiblingSort(FilterNullItems(Items));
        foreach (TItem item in sortedRootItems)
        {
            TreeNodeState<TItem> rootNode = BuildNode(item, depth: 0, parent: null, ancestors: []);
            RootNodes.Add(rootNode);
        }
    }

    private TreeNodeState<TItem> BuildNode(
        TItem item,
        int depth,
        TreeNodeState<TItem>? parent,
        HashSet<TItem> ancestors)
    {
        bool addedToAncestors = ancestors.Add(item);
        IEnumerable<TItem> childItems = Enumerable.Empty<TItem>();

        if (addedToAncestors)
        {
            childItems = FilterNullItems(ChildItemsSelector(item) ?? Enumerable.Empty<TItem>());
        }

        List<TItem> orderedChildren = ApplySiblingSort(childItems).ToList();
        TreeNodeState<TItem> node = new()
        {
            Item = item,
            Depth = depth,
            Parent = parent,
            HasChildren = HasChildrenSelector?.Invoke(item) ?? orderedChildren.Count > 0,
            IsExpanded = ExpandedStates.TryGetValue(item, out bool isExpanded) && isExpanded,
            Children = []
        };

        if (addedToAncestors)
        {
            foreach (TItem childItem in orderedChildren)
            {
                TreeNodeState<TItem> childNode = BuildNode(childItem, depth + 1, node, ancestors);
                node.Children.Add(childNode);
            }

            ancestors.Remove(item);
        }

        return node;
    }

    private IEnumerable<TItem> ApplySiblingSort(IEnumerable<TItem> items) =>
        TableQueryHelpers.ApplySort(items, SortColumnKey, SortAscending, Columns);

    private static IEnumerable<TItem> FilterNullItems(IEnumerable<TItem> items) =>
        items.Where(static item => item is not null);

    private bool MatchesSearch(TItem item, string filter) =>
        TableQueryHelpers.MatchesSearch(item, filter, Columns, SearchPredicate);

    private void CollectExpandedNodes(TreeNodeState<TItem> node, List<TreeNodeState<TItem>> visibleNodes)
    {
        visibleNodes.Add(node);

        if (!node.IsExpanded)
            return;

        foreach (TreeNodeState<TItem> child in node.Children)
            CollectExpandedNodes(child, visibleNodes);
    }

    private bool CollectSearchNodes(
        TreeNodeState<TItem> node,
        string filter,
        List<TreeNodeState<TItem>> visibleNodes,
        out bool includeNode)
    {
        bool matchesSelf = MatchesSearch(node.Item, filter);
        int insertIndex = visibleNodes.Count;
        List<TreeNodeState<TItem>> childMatches = [];

        foreach (TreeNodeState<TItem> child in node.Children)
        {
            CollectSearchNodes(child, filter, childMatches, out bool childIncluded);
            _ = childIncluded;
        }

        includeNode = matchesSelf || childMatches.Count > 0;
        if (!includeNode)
            return false;

        visibleNodes.Insert(insertIndex, node);
        visibleNodes.AddRange(childMatches);
        return true;
    }

    private void SortBy(string columnKey)
    {
        if (SortColumnKey == columnKey)
            SortAscending = !SortAscending;
        else
        {
            SortColumnKey = columnKey;
            SortAscending = true;
        }

        RebuildTree();
    }

    private string GetSortIcon(string key)
    {
        if (SortColumnKey != key) return "bi-arrow-down-up";
        return SortAscending ? "bi-sort-up" : "bi-sort-down";
    }

    private void HideColumn(string key) => HiddenColumns.Add(key);
    private void ShowColumn(string key) => HiddenColumns.Remove(key);

    private Task ToggleNodeAsync(TreeNodeState<TItem> node)
    {
        node.IsExpanded = !node.IsExpanded;
        ExpandedStates[node.Item] = node.IsExpanded;
        return Task.CompletedTask;
    }

    private void HandleSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            debounceTimer?.Dispose();
            ApplySearch();
        }
    }

    private void ApplySearch()
    {
        AppliedSearchText = SearchText;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        SearchText = string.Empty;
        AppliedSearchText = string.Empty;
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;

        debounceTimer?.Dispose();
        debounceTimer = new Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                AppliedSearchText = SearchText;
                StateHasChanged();
            });
        }, null, 250, Timeout.Infinite);
    }

    public void Dispose() => debounceTimer?.Dispose();
}


