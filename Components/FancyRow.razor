@typeparam TItem

@if (ShouldRenderCustomTemplate)
{
    @RowTemplate!(RowContext)
}
else
{
    <tr class="@GetRowClass()" @attributes="GetRowAttributes()">
        @for (int index = 0; index < VisibleColumns.Count; index++)
        {
            FancyColumn<TItem> column = VisibleColumns[index];

            <td class="@GetCellClass(column)" style="@GetCellStyle(column)">
                @if (index == 0 && RowLeadingContentTemplate is not null)
                {
                    @RowLeadingContentTemplate(RowContext)
                }

                @if (column.CellTemplate is not null)
                {
                    @column.CellTemplate(Item)
                }
                else
                {
                    <span class="fancy-cell-value"
                          data-expandable="@(IsColumnConstrained(column) ? "true" : "false")">
                        @column.ValueSelector?.Invoke(Item)
                    </span>
                }
            </td>
        }
    </tr>
}

@code {
    [Parameter, EditorRequired]
    public required TItem Item { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<FancyColumn<TItem>> VisibleColumns { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyDictionary<string, double> ColumnWidths { get; set; }

    [Parameter]
    public Func<TItem, string?>? RowClassSelector { get; set; }

    [Parameter]
    public Func<FancyRowContext<TItem>, IReadOnlyDictionary<string, object?>?>? RowAttributesSelector { get; set; }

    [Parameter]
    public RenderFragment<FancyRowContext<TItem>>? RowLeadingContentTemplate { get; set; }

    [Parameter]
    public RenderFragment<FancyRowContext<TItem>>? RowTemplate { get; set; }

    [Parameter]
    public Func<FancyRowContext<TItem>, bool>? RowTemplateSelector { get; set; }

    private FancyRowContext<TItem> RowContext => new()
    {
        Item = Item,
        Columns = VisibleColumns,
        ToggleNode = EventCallback.Empty,
        ExpandLabel = string.Empty,
        CollapseLabel = string.Empty,
        IsTreeNode = false,
        Depth = 0,
        HasChildren = false,
        IsExpanded = false
    };

    private bool ShouldRenderCustomTemplate =>
        RowTemplate is not null && (RowTemplateSelector?.Invoke(RowContext) ?? true);

    private string? GetRowClass() => RowClassSelector?.Invoke(Item);

    private IReadOnlyDictionary<string, object?>? GetRowAttributes() => RowAttributesSelector?.Invoke(RowContext);

    private string? GetCellClass(FancyColumn<TItem> column) =>
        IsColumnConstrained(column)
            ? string.IsNullOrWhiteSpace(column.CellClass) ? "fancy-cell-constrained" : $"{column.CellClass} fancy-cell-constrained"
            : column.CellClass;

    private string? GetCellStyle(FancyColumn<TItem> column)
    {
        if (ColumnWidths.TryGetValue(column.Key, out double width))
        {
            return FormattableString.Invariant($"width:{width:0.##}px;max-width:{width:0.##}px;");
        }

        return column.MaxWidth is double maxWidth
            ? FormattableString.Invariant($"max-width:{maxWidth:0.##}px;")
            : null;
    }

    private bool IsColumnConstrained(FancyColumn<TItem> column) =>
        ColumnWidths.ContainsKey(column.Key) || column.MaxWidth.HasValue;
}
