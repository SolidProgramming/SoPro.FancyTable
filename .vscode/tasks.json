{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Benchmarks: Dry (all)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "benchmarks/SoPro.FancyTable.Benchmarks/SoPro.FancyTable.Benchmarks.csproj",
        "-c",
        "Release",
        "--",
        "--filter",
        "*",
        "--job",
        "Dry"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Quick functional check of all benchmarks; not a meaningful timing comparison."
    },
    {
      "label": "Benchmarks: Short (all)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "benchmarks/SoPro.FancyTable.Benchmarks/SoPro.FancyTable.Benchmarks.csproj",
        "-c",
        "Release",
        "--",
        "--filter",
        "*",
        "--job",
        "Short"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Short measurement run of all flat and tree benchmarks."
    },
    {
      "label": "Benchmarks: Full (flat table)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "benchmarks/SoPro.FancyTable.Benchmarks/SoPro.FancyTable.Benchmarks.csproj",
        "-c",
        "Release",
        "--",
        "--filter",
        "*FlatPreparationBenchmarks*"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Full default measurement run of flat-table benchmarks only."
    },
    {
      "label": "Benchmarks: Full (tree table)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "benchmarks/SoPro.FancyTable.Benchmarks/SoPro.FancyTable.Benchmarks.csproj",
        "-c",
        "Release",
        "--",
        "--filter",
        "*TreePreparationBenchmarks*"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Full default measurement run of tree-table benchmarks only."
    },
    {
      "label": "Browser Benchmarks: Install Chromium",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "benchmarks/SoPro.FancyTable.BrowserBenchmarks/SoPro.FancyTable.BrowserBenchmarks.csproj",
        "-c",
        "Release",
        "--",
        "--install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Install the Chromium build required by the Playwright browser benchmarks."
    },
    {
      "label": "Browser Benchmarks: Dry",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "benchmarks/SoPro.FancyTable.BrowserBenchmarks/SoPro.FancyTable.BrowserBenchmarks.csproj",
        "-c",
        "Release",
        "--",
        "--profile",
        "Dry"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Functional smoke run of all 48 browser benchmark actions."
    },
    {
      "label": "Browser Benchmarks: Dry (Headed)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "benchmarks/SoPro.FancyTable.BrowserBenchmarks/SoPro.FancyTable.BrowserBenchmarks.csproj",
        "-c",
        "Release",
        "--",
